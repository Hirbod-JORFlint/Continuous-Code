env = os.environ.copy()
env["OPC_PROJECT_DIR"] = os.getcwd()
env["OPC_EVENT"] = 'PostToolUse'
HOOKS = 'typescript-preflight compiler-in-the-loop post-edit-notify post-edit-diagnostics handoff-index post-tool-use-tracker braintrust-post-tool-use import-validator import-error-detector'.split()
LAUNCHER = os.path.expanduser("~/.opc/hooks/hook_launcher.py")
for hook in HOOKS:
    subprocess.run(
        [sys.executable, LAUNCHER, hook],
        input=payload, capture_output=True, env=env,
    )
# Cline expects response JSON; the neutral hooks are advisory.
print('{"cancel":false,"contextModification":""}')
