# Forwards the Cline stdin JSON into the payload adapter.
import os, subprocess, sys
payload = sys.stdin.read()
env = os.environ.copy()
env["OPC_PROJECT_DIR"] = os.getcwd()
env["OPC_EVENT"] = 'TaskStart'
HOOKS = 'persist-project-dir braintrust-session-start session-register session-symbol-index session-start-continuity session-start-tldr-cache'.split()
LAUNCHER = os.path.expanduser("~/.opc/hooks/hook_launcher.py")
for hook in HOOKS:
    subprocess.run(
        [sys.executable, LAUNCHER, hook],
        input=payload, capture_output=True, env=env,
    )
# Cline expects response JSON; the neutral hooks are advisory.
print('{"cancel":false,"contextModification":""}')
