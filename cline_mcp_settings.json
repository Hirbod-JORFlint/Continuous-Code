{
  "mcpServers": {
    "ast-grep": {
      "command": "npx",
      "disabled": true,
      "autoApprove": [],
      "args": [
        "-y",
        "@anthropic/mcp-ast-grep"
      ]
    },
    "fetch": {
      "command": "uvx",
      "disabled": false,
      "autoApprove": [],
      "args": [
        "mcp-server-fetch"
      ]
    },
    "firecrawl": {
      "command": "npx",
      "disabled": true,
      "autoApprove": [],
      "args": [
        "-y",
        "firecrawl-mcp"
      ],
      "env": {
        "FIRECRAWL_API_KEY": "${env:FIRECRAWL_API_KEY}"
      }
    },
    "git": {
      "command": "uvx",
      "disabled": false,
      "autoApprove": [],
      "args": [
        "mcp-server-git",
        "--repository",
        "."
      ]
    },
    "github": {
      "type": "streamableHttp",
      "url": "https://api.githubcopilot.com/mcp/",
      "disabled": true,
      "autoApprove": [],
      "headers": {
        "Authorization": "Bearer ${env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "morph": {
      "command": "npx",
      "disabled": true,
      "autoApprove": [],
      "args": [
        "-y",
        "@morphllm/morphmcp"
      ],
      "env": {
        "MORPH_API_KEY": "${env:MORPH_API_KEY}"
      }
    },
    "nia": {
      "command": "pipx",
      "disabled": true,
      "autoApprove": [],
      "args": [
        "run",
        "--no-cache",
        "nia-mcp-server"
      ],
      "env": {
        "NIA_API_KEY": "${env:NIA_API_KEY}",
        "NIA_API_URL": "https://apigcp.trynia.ai/"
      }
    },
    "perplexity": {
      "command": "npx",
      "disabled": true,
      "autoApprove": [],
      "args": [
        "-y",
        "@perplexity-ai/mcp-server"
      ],
      "env": {
        "PERPLEXITY_API_KEY": "${env:PERPLEXITY_API_KEY}"
      }
    },
    "qlty": {
      "command": "C:\\Users\\Hirbod/.opc/venv/bin/python",
      "disabled": false,
      "autoApprove": [],
      "args": [
        "C:\\Users\\Hirbod/.opc/servers/qlty/server.py"
      ]
    },
    "repoprompt": {
      "command": "repoprompt_cli",
      "disabled": true,
      "autoApprove": []
    }
  }
}
